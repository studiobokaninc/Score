CALENDAR_BASE_URL=http://192.168.44.253:8001
CALENDAR_M2M_TOKEN=<your-m2m-token>
JWT_SECRET=<your-jwt-secret>
# cmd_172: 外部の道具(Casper等)用サービス資格の署名鍵。JWT_SECRET とは別の値にすること
# (利用者用鍵とサービス用鍵の分離・軍師QC172A-2)。未設定でも既存機能に影響なし
# (サービス経由の名乗り上書きが使えないだけ)。
SCORE_SERVICE_JWT_SECRET=<your-service-jwt-secret>
DATABASE_URL=sqlite:///./score.db
CALENDAR_MOCK=0
